#!/bin/sh
# digits-recovery-check: Gate for recovery mode.
# Exits immediately if no recovery flag -- lets normal boot continue.
# If flag exists, waits for WiFi hardware, starts recovery server.

RECOVERY_FLAG="/run/digits-recovery-mode"
RECOVERY_FLAG_DATA="/data/digits/recovery-mode"

if [ ! -f "$RECOVERY_FLAG" ] && [ ! -f "$RECOVERY_FLAG_DATA" ]; then
    exit 0
fi

echo "digits-recovery: flag found, entering recovery mode"

# Remove flags so a reboot from recovery doesn't loop
rm -f "$RECOVERY_FLAG" "$RECOVERY_FLAG_DATA"

# Wait for wlan0 to appear (udev + brcmfmac firmware load)
TRIES=0
while [ $TRIES -lt 15 ] && ! ip link show wlan0 > /dev/null 2>&1; do
    TRIES=$((TRIES + 1))
    sleep 1
done

# Stop services that would fight for wlan0
systemctl stop NetworkManager.service 2>/dev/null || true
systemctl stop wpa_supplicant.service 2>/dev/null || true
sleep 1

# Unblock WiFi radio (rfkill may have soft-blocked it)
rfkill unblock wifi 2>/dev/null || true

# Mount recovery partition (contains factory images)
mount /recovery || { echo "digits-recovery: failed to mount /recovery"; exit 1; }

# Hand off to recovery server (does not return until reset/reboot)
export RECOVERY_DIR=/recovery
export BOOT_COUNTER_PATH=/data/digits/boot-counter
exec /usr/local/bin/digits-recovery
