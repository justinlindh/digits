#!/bin/bash
# digits-ap-check: Manage AP mode vs. station mode for Wi-Fi.
# Subcommands:
#   init  -- boot-time decision: read flag, go into station or AP mode (default)
#   up    -- unconditionally bring the setup AP up
#   down  -- unconditionally tear the setup AP down and hand wlan0 to NetworkManager
#
# Called by digits-ap-check.service (Before=network-pre.target) as: digits-ap-check init
#
# NOTE: Root filesystem is read-only. Use systemctl start/stop only, never enable/disable.

set -euo pipefail

WIFI_CONFIGURED_FLAG="/data/wifi-configured"
NM_CONN_SRC="/data/wifi/digits-wifi.nmconnection"
NM_CONN_DST="/etc/NetworkManager/system-connections/digits-wifi.nmconnection"
LOG_TAG="digits-ap-check"

log() {
    echo "$LOG_TAG: $*" | tee /dev/kmsg 2>/dev/null || true
    logger -t "$LOG_TAG" "$*" 2>/dev/null || true
}

# Validate that an nmconnection file is not corrupt.
# Returns 0 if valid, 1 if missing/corrupt.
validate_nmconnection() {
    local file="$1"
    if [ ! -f "$file" ]; then
        log "VALIDATE: file missing: $file"
        return 1
    fi
    if [ ! -s "$file" ]; then
        log "VALIDATE: file empty: $file"
        return 1
    fi
    # Check for null bytes (sign of filesystem corruption).
    # A valid nmconnection file is plain text and should never contain nulls.
    if grep -Pq '\x00' "$file"; then
        log "VALIDATE: file contains null bytes: $file"
        return 1
    fi
    # Must contain key NM connection sections
    if ! grep -q '^\[connection\]' "$file" || ! grep -q '^\[wifi\]' "$file"; then
        log "VALIDATE: file missing required [connection] or [wifi] sections: $file"
        return 1
    fi
    return 0
}

# Clear wifi-configured state so the device falls back to AP mode.
reset_wifi_config() {
    log "Resetting wifi config -- will enter AP mode"
    rm -f "$WIFI_CONFIGURED_FLAG"
    rm -f "$NM_CONN_SRC"
}

do_station_up() {
    log "Wi-Fi configured — starting normal boot"

    # Stop AP services
    systemctl stop digits-ap.service digits-dnsmasq-ap.service digits-setup.service 2>/dev/null || true

    # Unblock WiFi radio
    rfkill unblock wifi || true

    # Copy NM connection to where NetworkManager expects it.
    # /etc is on ro root, so we need a tmpfs or remount. Use a tmpfs bind mount.
    if [ -f "$NM_CONN_SRC" ]; then
        # Remount rw briefly to copy the connection file
        mount -o remount,rw / 2>/dev/null || true
        cp "$NM_CONN_SRC" "$NM_CONN_DST" 2>/dev/null || true
        chmod 600 "$NM_CONN_DST" 2>/dev/null || true
        mount -o remount,ro / 2>/dev/null || true
        log "Copied NM connection file"
    else
        log "WARNING: No NM connection file found at $NM_CONN_SRC"
    fi

    # Let NetworkManager handle everything (wpa_supplicant runs under NM via D-Bus)
    log "Wi-Fi client mode — NetworkManager will connect"
}

do_ap_up() {
    log "Wi-Fi not configured — entering AP mode"

    # Kill NetworkManager — it fights hostapd for wlan0 and re-blocks rfkill
    systemctl stop NetworkManager.service 2>/dev/null || true

    # Stop wpa_supplicant so it doesn't fight hostapd
    systemctl stop "wpa_supplicant@wlan0.service" 2>/dev/null || true
    systemctl stop wpa_supplicant.service 2>/dev/null || true

    # Unblock WiFi radio
    rfkill unblock wifi || true
    sleep 1

    # Configure wlan0 with static IP for AP mode
    /usr/local/bin/digits-ap-setup

    # Stop digitsd in AP mode
    systemctl stop digitsd.service 2>/dev/null || true

    # Ensure hostapd SSID is not the build-time placeholder.
    # digits-first-boot.sh normally sets this, but if first-boot was skipped
    # (e.g. /data/.initialized already existed) or failed, the placeholder
    # persists. Resolve it here before starting hostapd.
    HOSTAPD_CONF="/etc/hostapd/digits-ap.conf"
    CURRENT_SSID=$(grep '^ssid=' "$HOSTAPD_CONF" | cut -d= -f2)
    if [ "$CURRENT_SSID" = "Digits-XXXX" ]; then
        log "SSID is still placeholder — resolving"
        DEVICE_ID_FILE="/data/digits/device-id"
        if [ -f "$DEVICE_ID_FILE" ]; then
            SUFFIX=$(tr -d '\n' < "$DEVICE_ID_FILE" | tail -c 4)
        else
            SUFFIX=$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 4)
        fi
        NEW_SSID="Digits-${SUFFIX}"
        mount -o remount,rw / 2>/dev/null || true
        sed -i "s/^ssid=.*/ssid=${NEW_SSID}/" "$HOSTAPD_CONF"
        sync
        mount -o remount,ro / 2>/dev/null || true
        log "Updated SSID to: ${NEW_SSID}"
    fi

    # Start AP services (--no-block to avoid deadlock with network.target)
    systemctl start --no-block digits-ap.service
    systemctl start --no-block digits-dnsmasq-ap.service
    systemctl start --no-block digits-setup.service

    log "AP mode started — SSID: $(grep '^ssid=' /etc/hostapd/digits-ap.conf | cut -d= -f2)"
}

do_ap_down() {
    log "Tearing down AP mode — handing wlan0 back to NetworkManager"

    systemctl stop digits-setup.service 2>/dev/null || true
    systemctl stop digits-dnsmasq-ap.service 2>/dev/null || true
    systemctl stop digits-ap.service 2>/dev/null || true

    ip addr flush dev wlan0 2>/dev/null || true
    ip link set wlan0 down 2>/dev/null || true

    systemctl start NetworkManager

    log "AP mode down — NetworkManager started"
}

do_init() {
    if [ -f "$WIFI_CONFIGURED_FLAG" ]; then
        # Validate the config file before trusting it
        if ! validate_nmconnection "$NM_CONN_SRC"; then
            log "WARNING: Wi-Fi config is corrupt or missing -- falling back to AP mode"
            reset_wifi_config
            # Fall through to the AP mode block below
        fi
    fi

    if [ -f "$WIFI_CONFIGURED_FLAG" ]; then
        do_station_up
    else
        do_ap_up
    fi
}

case "${1:-init}" in
    init)  do_init ;;
    up)    do_ap_up ;;
    down)  do_ap_down ;;
    *)
        echo "usage: $0 {init|up|down}" >&2
        exit 2
        ;;
esac
