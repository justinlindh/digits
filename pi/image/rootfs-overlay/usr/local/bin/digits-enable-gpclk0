#!/usr/bin/env python3
"""
digits-enable-gpclk0: enable BCM2835/2837 GPCLK0 on Pi GPIO4 at ~12.288 MHz.

V2 carrier wires Pi GPIO4 (GPCLK0 function) to the TLV320AIC3104 MCLK pin.
The codec's PLL needs that reference clock to lock; without it, hw_params
succeeds at the kernel level but the actual audio output is silence or
static. raspi-config used to set this up indirectly via dtparam=audio; we
purge raspi-config and don't use the BCM2835 PCM driver path, so we have
to enable GPCLK0 explicitly.

Configuration:
  Source = OSC (19.2 MHz crystal on Pi)
  Divider = 19.2 / 12.288 = 1.5625 (DIVI=1 + DIVF=2304/4096)
  MASH = 1 (one-stage noise shaping; some jitter, but the codec's PLL
            tolerates it for non-bypass sample rates such as 44.1 kHz)
  GPIO4 fn = ALT0 (GPCLK0 output)

Run as root. Idempotent: safe to invoke at every boot.
"""
import mmap, os, struct, time, sys

CLK_BASE = 0x3F101000
GPIO_BASE = 0x3F200000
PASSWD = 0x5A000000

CTL_OFF = 0x70  # CM_GP0CTL
DIV_OFF = 0x74  # CM_GP0DIV

clk_fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
clk_mm = mmap.mmap(clk_fd, 0x1000, offset=CLK_BASE)

gpio_fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
gpio_mm = mmap.mmap(gpio_fd, 0x1000, offset=GPIO_BASE)

def w(mm, off, v):
    mm[off:off+4] = struct.pack("<I", v)

def r(mm, off):
    return struct.unpack("<I", mm[off:off+4])[0]

# 1. Disable GPCLK0
w(clk_mm, CTL_OFF, PASSWD | 0)
time.sleep(0.001)
# Wait BUSY clear (bit 7)
for _ in range(100):
    if (r(clk_mm, CTL_OFF) & (1 << 7)) == 0:
        break
    time.sleep(0.001)

# 2. Program divider: 1.5625 -> DIVI=1, DIVF=2304
DIVI = 1
DIVF = 2304
w(clk_mm, DIV_OFF, PASSWD | (DIVI << 12) | DIVF)

# 3. Set source = OSC (1), MASH = 1 (one-stage)
w(clk_mm, CTL_OFF, PASSWD | (1 << 9) | 1)
time.sleep(0.001)

# 4. Enable
w(clk_mm, CTL_OFF, PASSWD | (1 << 9) | 1 | (1 << 4))
time.sleep(0.001)

# 5. Set GPIO4 to ALT0 (function bits = 100 = 4)
GPFSEL0_OFF = 0x00
fn_bits = 4  # ALT0
shift = 4 * 3  # GPIO4 is bits 14:12 of GPFSEL0
v = r(gpio_mm, GPFSEL0_OFF)
v &= ~(0b111 << shift)
v |= (fn_bits << shift)
w(gpio_mm, GPFSEL0_OFF, v)

# Verify
ctl = r(clk_mm, CTL_OFF)
divv = r(clk_mm, DIV_OFF)
fsel = r(gpio_mm, GPFSEL0_OFF)
gpio4_fn = (fsel >> shift) & 0b111
fn_names = {0:"INPUT", 1:"OUTPUT", 4:"ALT0", 5:"ALT1", 6:"ALT2", 7:"ALT3", 3:"ALT4", 2:"ALT5"}

print(f"CM_GP0CTL = 0x{ctl & 0xFFFFFF:06x}  (BUSY={(ctl>>7)&1}, ENAB={(ctl>>4)&1}, MASH={(ctl>>9)&3}, SRC={ctl&0xF})")
print(f"CM_GP0DIV = DIVI={divv >> 12 & 0xFFF}, DIVF={divv & 0xFFF}")
print(f"GPFSEL0   = 0x{fsel:08x}  (GPIO4 fn = {gpio4_fn} = {fn_names.get(gpio4_fn,'?')})")
expected = 19200000 * 4096 / (DIVI * 4096 + DIVF)
print(f"Expected GPCLK0 frequency = {expected:.3f} Hz ({expected/1e6:.4f} MHz)")

clk_mm.close()
gpio_mm.close()
os.close(clk_fd)
os.close(gpio_fd)
