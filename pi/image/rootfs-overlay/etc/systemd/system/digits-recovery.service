[Unit]
Description=Digits Recovery Mode (AP + Factory Reset Server)
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
Before=digitsd.service digits-ap-check.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/digits-recovery-check
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
