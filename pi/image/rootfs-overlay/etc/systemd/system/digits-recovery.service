[Unit]
Description=Digits Recovery Mode (AP + Factory Reset Server)
ConditionPathExists=/run/digits-recovery-mode
After=local-fs.target systemd-modules-load.service
Before=digitsd.service
Conflicts=digitsd.service digits-ap-check.service digits-ap.service digits-dnsmasq-ap.service NetworkManager.service

[Service]
Type=simple
ExecStartPre=/bin/mount /recovery
ExecStart=/usr/local/bin/digits-recovery
ExecStopPost=-/bin/umount /recovery
ExecStopPost=-/bin/rm -f /run/digits-recovery-mode
Environment=RECOVERY_DIR=/recovery
Environment=BOOT_COUNTER_PATH=/data/digits/boot-counter
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
