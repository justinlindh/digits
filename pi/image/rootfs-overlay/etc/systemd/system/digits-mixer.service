[Unit]
Description=Restore Digits Audio Mixer State
After=sound.target
Before=digitsd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'alsactl restore digitscodec -f /data/digits_mixer.state 2>/dev/null || alsactl restore Zero -f /data/digits_mixer.state 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
