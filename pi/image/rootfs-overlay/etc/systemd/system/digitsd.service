[Unit]
Description=Digits Phone Daemon
Documentation=https://github.com/justinlindh/digits
# Wait for sysinit and digits-first-boot before starting; digitsd's asset
# extractor flips the rootfs rw/ro mid-boot, which races with first-boot's
# own rw remount and causes first-boot's writes to fail with EROFS.
# Wants= (soft) so a permanently-broken first-boot does not strand digitsd.
After=sound.target sysinit.target digits-first-boot.service
Wants=digits-first-boot.service

[Service]
Type=simple
User=digits
Group=digits
ExecStartPre=+/usr/local/bin/digitsd --mode=gpclk0
ExecStartPre=+/bin/sh -c 'alsactl restore digitscodec -f /data/digits_mixer.state 2>/dev/null || alsactl restore Zero -f /data/digits_mixer.state 2>/dev/null || true'
ExecStart=/usr/local/bin/digitsd \
    -config /data/digits/config.json \
    -serial /dev/serial0 \
    -tones /data/digits/tones \
    -socket /data/digits/uart.sock

Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Allow serial port access + audio + GPIO
SupplementaryGroups=dialout audio gpio i2c spi

[Install]
WantedBy=multi-user.target
