/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2835";

    /* Enable I2C1 for codec control */
    fragment@0 {
        target = <&i2c1>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            codec: tlv320aic3104@18 {
                compatible = "ti,tlv320aic3104";
                reg = <0x18>;
                #sound-dai-cells = <0>;
                AVDD-supply = <&vdd_3v3_reg>;
                IOVDD-supply = <&vdd_3v3_reg>;
                DRVDD-supply = <&vdd_3v3_reg>;
            };
        };
    };

    /* Enable I2S */
    fragment@1 {
        target = <&i2s>;
        __overlay__ {
            status = "okay";
        };
    };

    /* Sound card using simple-audio-card */
    fragment@2 {
        target-path = "/";
        __overlay__ {
            digits_sound: digits-sound {
                compatible = "simple-audio-card";
                simple-audio-card,name = "digitscodec";
                simple-audio-card,format = "i2s";
                status = "okay";

                simple-audio-card,cpu {
                    sound-dai = <&i2s>;
                };

                simple-audio-card,codec {
                    sound-dai = <&codec>;
                };
            };
        };
    };
};
