[Unit]
Description=DAC keepalive silence stream (prevents DA7212 power-down latency)
After=sound.target digits-mixer.service
Wants=digits-mixer.service

[Service]
ExecStart=/usr/bin/aplay -D default -t raw -f S16_LE -r 48000 -c 1 /dev/zero
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
