# Build output
firmware/build/
firmware/test/build/
tools/build/
artifacts/*

# Compiled binaries
server/bin/

# rnnoise test binaries (keep lib/ and rnnoise.h)
pi/rnnoise/rnnoise_rp_arm64
pi/rnnoise/rnnoise_bench
pi/rnnoise/rnnoise_rp
pi/rnnoise/rnnoise_loop

# Secrets / env
server/.env
server/.env.*
# ...but keep committed example files; real .env and .env.dev stay ignored.
!server/.env.example
!server/.env.dev.example
server/certs/

# Media / images
images/
# ...but the webapp ships a small PNG asset under static/images
!server/internal/web/static/images/
!server/internal/web/static/images/*
*.img
*.img.gz
*.img.xz
digits-pi-*

# Site (lives in separate repo)
site-astro/

# Node
node_modules/

# Worktrees
.worktrees/

# Superpowers
.superpowers/
docs/superpowers/

# Claude Code
.claude/
CLAUDE.local.md

# KiCad editor state
*.kicad_prl

# KiCad build artifacts (regenerate on demand)
hardware/pcb/*/gerber/

# Misc
__pycache__/
*.pyc
*.png
# Webapp ships a small PNG under static/images/; keep it tracked
!server/internal/web/static/images/*.png
# STL preview renders for the keypad badges: kept so the GitHub file
# browser shows what each printable mesh looks like.
!hardware/badges/*.png
# The printed device manual ships a cover image and reference screenshots.
!docs/manual/static/images/
!docs/manual/static/images/*.png
!docs/manual/reference-screenshots/
!docs/manual/reference-screenshots/*.png
sd-backup-pre-factory-reset.img.zst
