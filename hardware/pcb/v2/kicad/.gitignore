# KiCad lock files (created while KiCad has project open)
*.lck

# KiCad auto-backups
*-backups/

# KiCad local history
.history/
.history_trim/

# Local pre-routing / checkpoint snapshots (not part of board source)
*-pre-freeroute.*

# Fabrication toolkit plugin-local config
fabrication-toolkit-options.json

# Autorouter intermediate files
*.dsn
*.ses
*.rules

# DRC / ERC output artifacts
*_drc_violations.json
*-erc.rpt

# kicad-mcp-server snapshots
snapshots/

# Fabrication toolkit outputs: regenerated per build. Track only bom.csv
# as the hand-audited source of truth for the assembly order.
production/*
!production/bom.csv
