	(footprint "digits-pcb:SW_DPDT_Hook_24.2x17.1mm"
		(layer "B.Cu")
		(uuid "f2c662db-42ac-4e67-b589-4f58ff235c0d")
		(at 53.7079 39.1563 -90)
		(descr "DPDT telephone hook switch, IL Switch 2240 / Innocent INH-2240 family. Body 24.4 x 17.2mm. 6 signal pins 0.9mm on a 5.0 x 5.0mm grid (3 cols x 2 rows). The 7.45/7.75mm datasheet dims are mounting-feature offsets, not signal-pin spacing. Pole A common = pin 3, pole B common = pin 6; at rest 1-3 and 4-6 closed, pressed/on-hook 2-3 and 5-6 closed per datasheet. Genuine part also has 2x 2.1mm mounting holes, deliberately omitted to match the donor PCB; long signal pins seat the switch. Body outline is nominal (24.4 x 17.2mm) centered on the signal grid; the 6 pads are the precise reference, verified against a 1:1 printout.")
		(tags "switch DPDT hook telephone THT INH-2240 IL-2240")
