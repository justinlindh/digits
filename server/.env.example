# Digits Server — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.

# ─────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────

# Public base URL of your server (no trailing slash).
# Used for magic link emails and OAuth callbacks.
BASE_URL=https://digits.example.com

# Shared secret between signald and admind.
# Used to authenticate the internal stats endpoint.
# Generate with: openssl rand -hex 32
ADMIN_SECRET=change-me-to-something-random

# ─────────────────────────────────────────────
# Admin Panel
# ─────────────────────────────────────────────

# Username and password for the initial admin account.
# Created automatically on first startup if it doesn't exist.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_SECRET=change-me-admin-password

# ─────────────────────────────────────────────
# SMTP (required for magic link emails)
# ─────────────────────────────────────────────

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From address shown in outbound emails.
SMTP_FROM=noreply@digits.example.com

# ─────────────────────────────────────────────
# Google OAuth (optional)
# ─────────────────────────────────────────────
# Leave blank to disable Google sign-in.
# Set up at: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly what's registered in Google Cloud Console.
GOOGLE_REDIRECT_URL=https://digits.example.com/auth/google/callback
